[user]
	email = neelgupta04@outlook.com
	name = Neel Gupta
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[core]
	editor = hx
[diff]
	tool = difft
	external = /Users/neel/.local/bin/difft-git
[difftool "difftastic"]
	cmd = sh -c '/Users/neel/.local/bin/difft-git "$1" "$2"' -- "$LOCAL" "$REMOTE"
[difftool]
	prompt = false
